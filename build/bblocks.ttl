<bblocks://ogc.ladm.land-parcels.parcelSpatialRepresentationDefinition> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Parcel Spatial Representation Definition" ;
    dct:abstract "The WA cadastral parcel-specific extension of the generic spatial representation definition pattern. Adds the jurisdictional source basis (rule type, source authority type, and verbatim source statement) needed to trace a parcel's vertical boundary back to a title, plan, statute, Crown Grant, strata statement, or other approved jurisdictional rule."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
