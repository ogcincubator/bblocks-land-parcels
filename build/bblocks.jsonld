  "name": "Building Blocks - Land parcels",
  "abstract": "This repository contains a JSON schema model for land parcels, semantically annotated and aligned with LADM conceptual model.\n\nThese schemas use a generalised 3D topology model to provide explicit definition of parcels required for survey record keeping. \n\nThe topology model supports transformations to well known geometry formats which may be used to visualise and validated geometry representations of  Parcel objects in 2 or 3D.\n",
  "sparqlEndpoint": "https://defs-dev.opengis.net/fuseki/query",
  "modified": "2026-08-26T00:40:41.251205",
  "tooling": {
    "bblocks-postprocess": {
      "commitId": "\"d5ae6f4bd95e268894921440229917592e2976c4",
      "shortCommitId": "\"d5ae6f",
      "date": "2026-08-25T08:35:43+00:00\""
    }
  },
