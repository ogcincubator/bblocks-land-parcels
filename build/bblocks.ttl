<https://ogcincubator.github.io/bblocks-land-parcels/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Land parcels" ;
    dct:abstract """This repository contains a JSON schema model for land parcels, semantically annotated and aligned with LADM conceptual model.

These schemas use a generalised 3D topology model to provide explicit definition of parcels required for survey record keeping. 

The topology model supports transformations to well known geometry formats which may be used to visualise and validated geometry representations of  Parcel objects in 2 or 3D.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-05-27T06:46:35.867056"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json>,
        <https://surroundaustralia.github.io/topo-feature/build/register.json> ;
    skos:hasTopConcept <bblocks://ogc.ladm.land-parcels.compound-name>,
        <bblocks://ogc.ladm.land-parcels.ontology>,
        <bblocks://ogc.ladm.land-parcels.parcel>,
        <bblocks://ogc.ladm.land-parcels.parcelCollection> ;
    skos:prefLabel "Building Blocks - Land parcels" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-land-parcels/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-land-parcels/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://ogcincubator.github.io/bblocks-land-parcels/build/bblocks.jsonld> ] ;
    foaf:homepage <https://ogcincubator.github.io/bblocks-land-parcels/> ;
    bblocks:hasValidationReport <https://ogcincubator.github.io/bblocks-land-parcels/build/tests/report.html> .

